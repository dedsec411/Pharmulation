SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
GEMINI_API_KEY="your-gemini-api-key"

# Server-only. Bypasses RLS - never expose to the client.
# Required for admin panel actions (promote user, delete case).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Prescription Lens. Server-only - never prefix with VITE_.
PRESCRIPTOAI_API_KEY=your_prescriptoai_key_here

# The shared demo account behind "Try it as a guest". Server-only: the password
# is exchanged for a session on the server so it never reaches the browser.
GUEST_EMAIL=guest@your-domain
GUEST_PASSWORD=the_demo_account_password
